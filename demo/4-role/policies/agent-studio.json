{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StudioObjectExistence",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::agent-studio-static"
    },
    {
      "Sid": "StudioObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::agent-studio-static/artifacts/*",
        "arn:aws:s3:::agent-studio-static/images/*",
        "arn:aws:s3:::agent-studio-static/source-files/*"
      ]
    }
  ]
}
