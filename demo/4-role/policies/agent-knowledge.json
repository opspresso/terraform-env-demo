{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KnowledgeObjectExistence",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::agent-knowledge-static"
    },
    {
      "Sid": "KnowledgeSources",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::agent-knowledge-static/organizations/*/documents/*",
        "arn:aws:s3:::agent-knowledge-static/agent-knowledge/audio/*"
      ]
    }
  ]
}
