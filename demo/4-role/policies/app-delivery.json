{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:PutLifecyclePolicy",
        "ecr:PutImageTagMutability",
        "ecr:PutImageScanningConfiguration",
        "ecr:TagResource"
      ],
      "Resource": "arn:aws:ecr:ap-northeast-2:*:repository/projects/*"
    },
    {
      "Sid": "ProjectPushSession",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Resource": "arn:aws:iam::*:role/app-delivery-push"
    }
  ]
}
