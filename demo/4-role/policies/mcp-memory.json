{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VectorIndexReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3vectors:PutVectors",
        "s3vectors:QueryVectors",
        "s3vectors:GetVectors",
        "s3vectors:DeleteVectors"
      ],
      "Resource": [
        "arn:aws:s3vectors:*:*:bucket/agent-studio-vector/index/memories",
        "arn:aws:s3vectors:*:*:bucket/agent-studio-prod-vector/index/memories"
      ]
    },
    {
      "Sid": "StateBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::agent-studio-memory/*",
        "arn:aws:s3:::agent-studio-prod-memory/*"
      ]
    },
    {
      "Sid": "StateBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::agent-studio-memory",
        "arn:aws:s3:::agent-studio-prod-memory"
      ]
    },
    {
      "Sid": "EmbeddingModel",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/amazon.titan-embed-text-v2:0"
      ]
    },
    {
      "Sid": "KnowledgeBaseRetrieve",
      "Effect": "Allow",
      "Action": [
        "bedrock:Retrieve"
      ],
      "Resource": [
        "arn:aws:bedrock:*:*:knowledge-base/C3NQOMBFVD"
      ]
    }
  ]
}
